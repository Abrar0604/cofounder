# --- Backend Secrets (backend/.env) ---
# Database
DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/swarn"

# Webhooks
META_WEBHOOK_SECRET="your_meta_webhook_secret"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"

# LLM Providers (LangChain / LangGraph)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# Redis (Event Bus)
REDIS_URL="redis://localhost:6379/0"

# --- Frontend Secrets (frontend/.env.local) ---
# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# External API URLs
NEXT_PUBLIC_API_URL="http://localhost:8000"
